<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>StudentAgeEditorPlus</AssemblyName>
    <RootNamespace>StudentAgeEditorPlus</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.3.1</Version>

    <!-- BepInEx 不需要这些, 保持 plugins 目录干净 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- 本地开发默认部署；发布脚本传 DeployToGame=false，只生成独立发布包。 -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    <!-- classlib 默认不把 NuGet 依赖 dll 落到 OutputPath；CSharpMath/SkiaSharp 现在是
         Typeset 库工程经 ProjectReference 传递来的 NuGet 依赖，CopyToPlugins 仍需要从
         OutputPath 白名单拣取这些托管 dll，故强制拷贝。 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- 游戏根目录(相对本工程: _modsrc/StudentAgeEditorPlus/ -> 上两级) -->
    <GameRoot>$(MSBuildProjectDirectory)\..\..</GameRoot>
    <ManagedDir>$(GameRoot)\StudentAge_Data\Managed</ManagedDir>
    <BepInExCore>$(GameRoot)\BepInEx\core</BepInExCore>
    <PluginOutDir>$(GameRoot)\BepInEx\plugins\StudentAgeEditorPlus</PluginOutDir>
  </PropertyGroup>

  <!-- Shared 默认编译进作者端；Runtime 是独立玩家插件，不能重复编译进 EditorPlus。 -->
  <ItemGroup>
    <Compile Remove="Runtime\**\*.cs" />
    <!-- Typeset 是被真实引用的一方排版类库（见下方 ProjectReference），其源码
         绝不能再被 SDK 默认通配编进 EditorPlus，否则类型重复（CS0101）。 -->
    <Compile Remove="Typeset\**\*.cs" />
    <!-- tools 是被 .gitignore 排除的本地分析/验证目录，不得被 SDK 默认通配
         编进插件；其中可能包含独立测试项目及其 obj 生成源码。 -->
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <!-- 构建 EditorPlus 时一并构建玩家端轻量运行库，但作者端程序集不引用它。 -->
    <ProjectReference Include="Runtime\StudentAgeSocialRoleRuntime.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- 排版类库（LaTeX 引擎）是真实引用：与上面 Runtime 的"只连带构建"不同，
         EditorPlus 编译期直接使用其 internal 类型（库侧 InternalsVisibleTo），
         其 DLL 与 NuGet 传递依赖（CSharpMath/SkiaSharp）随本工程一起进
         OutputPath / 插件目录。 -->
    <ProjectReference Include="Typeset\StudentAgeTypeset.csproj" />
  </ItemGroup>

  <!-- BepInEx / Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 游戏 / Unity 程序集 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 剧情图窗口改用新 Input System 包轮询键鼠（Keyboard/Mouse.current）；
         游戏启用了 Input System，旧 UnityEngine.Input（InputLegacyModule）运行时必炸，不得引用。 -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 块级公式预览把 PNG 字节解码进 Texture2D（ImageConversion.LoadImage 扩展）。 -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 中途剧情预览恢复背景滤镜与 CG 面板动画；均为游戏已自带程序集，不随插件打包。 -->
    <Reference Include="UIEffect">
      <HintPath>$(ManagedDir)\UIEffect.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(ManagedDir)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween.Modules">
      <HintPath>$(ManagedDir)\DOTween.Modules.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏自带 Newtonsoft.Json（ModCtrl 保存配置就在用），社交资料JSON导入导出复用它 -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 人物配置的事务保存保持与原编辑器完全相同的 JSON 序列化格式。 -->
    <Reference Include="MessagePack">
      <HintPath>$(ManagedDir)\MessagePack.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 本地开发构建后部署作者端；正式发布由 package-release.ps1 生成独立压缩包。 -->
  <Target Name="CopyToPlugins" AfterTargets="Build"
          Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(PluginOutDir)" />
    <ItemGroup>
      <!-- 白名单拣取，绝不整目录拷：OutputPath 里还有 System.Buffers/System.Memory/
           System.Numerics.Vectors/System.Runtime.CompilerServices.Unsafe——游戏
           Managed 已自带这四个，随包再带会双重加载冲突。 -->
      <PluginPayload Include="$(OutputPath)\$(AssemblyName).dll" />
      <PluginPayload Include="$(OutputPath)\StudentAgeTypeset.dll" />
      <PluginPayload Include="$(OutputPath)\CSharpMath.dll" />
      <PluginPayload Include="$(OutputPath)\CSharpMath.Rendering.dll" />
      <PluginPayload Include="$(OutputPath)\CSharpMath.Editor.dll" />
      <PluginPayload Include="$(OutputPath)\CSharpMath.SkiaSharp.dll" />
      <PluginPayload Include="$(OutputPath)\SkiaSharp.dll" />
      <!-- 原生 dll 由 Typeset 库的 None(CopyToOutputDirectory) 项流转进 OutputPath。 -->
      <PluginPayload Include="$(OutputPath)\libSkiaSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPayload)"
          DestinationFolder="$(PluginOutDir)"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[StudentAgeEditorPlus] 已部署到 $(PluginOutDir)\$(AssemblyName).dll（含 StudentAgeTypeset 与 CSharpMath/SkiaSharp 依赖）" />
  </Target>

</Project>
