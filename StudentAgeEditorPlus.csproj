<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>StudentAgeEditorPlus</AssemblyName>
    <RootNamespace>StudentAgeEditorPlus</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.4.22</Version>

    <!-- BepInEx 不需要这些, 保持 plugins 目录干净 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- 本地开发默认部署；发布脚本传 DeployToGame=false，只生成独立发布包。 -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>

    <!-- 游戏根目录(相对本工程: _modsrc/StudentAgeEditorPlus/ -> 上两级) -->
    <GameRoot>$(MSBuildProjectDirectory)\..\..</GameRoot>
    <ManagedDir>$(GameRoot)\StudentAge_Data\Managed</ManagedDir>
    <BepInExCore>$(GameRoot)\BepInEx\core</BepInExCore>
    <PluginOutDir>$(GameRoot)\BepInEx\plugins\StudentAgeEditorPlus</PluginOutDir>
  </PropertyGroup>

  <!-- 排除本地工具、测试以及旧工程目录中的构建残留。 -->
  <ItemGroup>
    <!-- 旧玩家端工程已迁出；排除目录中可能残留的本地 bin/obj 生成源码。 -->
    <Compile Remove="Runtime\**\*.cs" />
    <!-- tools 是被 .gitignore 排除的本地分析/验证目录，不得被 SDK 默认通配
         编进插件；其中可能包含独立测试项目及其 obj 生成源码。 -->
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <!-- BepInEx / Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 游戏 / Unity 程序集 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 剧情图窗口改用新 Input System 包轮询键鼠（Keyboard/Mouse.current）；
         游戏启用了 Input System，旧 UnityEngine.Input（InputLegacyModule）运行时必炸，不得引用。 -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextCoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 中途剧情预览恢复背景滤镜与 CG 面板动画；均为游戏已自带程序集，不随插件打包。 -->
    <Reference Include="UIEffect">
      <HintPath>$(ManagedDir)\UIEffect.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(ManagedDir)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween.Modules">
      <HintPath>$(ManagedDir)\DOTween.Modules.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏自带 Newtonsoft.Json（ModCtrl 保存配置就在用）。 -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 本地开发构建后部署作者端；正式发布由 package-release.ps1 生成独立压缩包。 -->
  <Target Name="CopyToPlugins" AfterTargets="Build"
          Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(PluginOutDir)" />
    <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll"
          DestinationFolder="$(PluginOutDir)"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[StudentAgeEditorPlus] 已部署到 $(PluginOutDir)\$(AssemblyName).dll" />
  </Target>

</Project>
